{
  "apiVersion": 3,
  "id": "theastraydev-usage-streak",
  "version": "1.1.1",
  "publisher": "TheAstrayDev",
  "name": "Usage-Streak",
  "description": "Local reported token activity, streaks and saved captures. Reads local Genex history, saved run captures and Genex Tools covers. Compatible with Genex 0.1.12.",
  "backend": "backend.mjs",
  "icon": "icon.svg",
  "capabilities": [
    "project.read"
  ],
  "tools": [
    {
      "name": "usage-summary",
      "description": "Read aggregate local reported token usage and streaks. Does not return prompts or private reasoning; not a billing report.",
      "parameters": {
        "type": "object",
        "properties": {
          "zone": {
            "type": "string",
            "description": "IANA time zone, for example UTC or Europe/Berlin. Defaults to UTC."
          }
        },
        "required": []
      }
    }
  ],
  "skills": [],
  "settings": [
    {
      "key": "profile",
      "label": "Genex profile directory (optional)",
      "type": "string",
      "default": ""
    }
  ],
  "panels": [
    {
      "id": "dashboard",
      "title": "Usage-Streak",
      "placement": "settings",
      "file": "dashboard.html"
    },
    {
      "id": "streak",
      "title": "Streak overview",
      "placement": "settings",
      "file": "streak.html"
    }
  ],
  "actions": [
    {
      "name": "analytics",
      "label": "Read local token activity"
    },
    {
      "name": "screenshot",
      "label": "Read saved Studio screenshot"
    },
    {
      "name": "changes",
      "label": "Compare saved game checkpoints"
    }
  ]
}