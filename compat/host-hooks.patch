diff --git a/src/shared/plugin-panel-navigation.ts b/src/shared/plugin-panel-navigation.ts
new file mode 100644
index 0000000..f69fec5
--- /dev/null
+++ b/src/shared/plugin-panel-navigation.ts
@@ -0,0 +1,10 @@
+/** A widget may open its own primary settings panel at one calendar day. No arbitrary navigation. */
+export const PLUGIN_DETAILS_METHOD = "customization.openDetails";
+export function pluginDetailsDay(args: unknown): string {
+  if (!args || typeof args !== "object" || Array.isArray(args) || Object.keys(args).some(key => key !== "day")) throw new Error("Expected a calendar day");
+  const day = (args as { day?: unknown }).day;
+  if (typeof day !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(day)) throw new Error("Expected YYYY-MM-DD");
+  const date = new Date(day + "T12:00:00Z");
+  if (!Number.isFinite(date.getTime()) || date.toISOString().slice(0, 10) !== day) throw new Error("Invalid calendar day");
+  return day;
+}
diff --git a/tests/conformance/plugin-panel-navigation.test.ts b/tests/conformance/plugin-panel-navigation.test.ts
new file mode 100644
index 0000000..2d3f9e7
--- /dev/null
+++ b/tests/conformance/plugin-panel-navigation.test.ts
@@ -0,0 +1,7 @@
+import {test} from "node:test";
+import assert from "node:assert/strict";
+import {pluginDetailsDay} from "../../src/shared/plugin-panel-navigation.ts";
+test("plugin day navigation validates real calendar dates and rejects arbitrary targets",()=>{
+  assert.equal(pluginDetailsDay({day:"2024-02-29"}),"2024-02-29");
+  for (const args of [null,[],{}, {day:"2026-02-30"},{day:"2026-13-01"},{day:"file:///secret"},{day:"2026-10-14",plugin:"other"},{day:"2026-10-14",url:"https://example.com"}]) assert.throws(()=>pluginDetailsDay(args));
+});
