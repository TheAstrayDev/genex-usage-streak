diff --git a/src/renderer/panels/plugin-panel-navigation.ts b/src/renderer/panels/plugin-panel-navigation.ts
new file mode 100644
index 0000000..c29bb21
--- /dev/null
+++ b/src/renderer/panels/plugin-panel-navigation.ts
@@ -0,0 +1,23 @@
+import { PLUGIN_DETAILS_METHOD, pluginDetailsDay } from "../../shared/plugin-panel-navigation.ts";
+import type { PluginInfo } from "../../shared/plugins.ts";
+import { OPEN_PLUGINS_EVENT } from "../ui/ComposerAddMenu.tsx";
+const requests = new Map<string, { panel: string; day: string; until: number }>();
+export { PLUGIN_DETAILS_METHOD };
+export function openPluginDetails(plugin: PluginInfo, args: unknown): void {
+  if (!plugin.enabled || plugin.removed || plugin.unlisted || !plugin.manifest.capabilities.includes("ui.customization")) throw new Error("Enabled UI customization plugin required");
+  const panel = plugin.manifest.panels.find(entry => entry.placement === "settings");
+  if (!panel) throw new Error("Declare a settings panel before opening details");
+  const day = pluginDetailsDay(args);
+  for (const [id, value] of requests) if (value.until < Date.now()) requests.delete(id);
+  if (requests.size >= 32 && !requests.has(plugin.manifest.id)) requests.delete(requests.keys().next().value!);
+  requests.set(plugin.manifest.id, { panel: panel.id, day, until: Date.now() + 60000 });
+  window.dispatchEvent(new CustomEvent(OPEN_PLUGINS_EVENT, { detail: { plugin: plugin.manifest.id } }));
+}
+export function pluginPanelNavigation(id: string, url: string): { day: string } | undefined {
+  const request = requests.get(id);
+  if (!request || request.until < Date.now()) return undefined;
+  try {
+    if (new URL(url).pathname.split("/").at(-1) !== request.panel) return undefined;
+  } catch { return undefined; }
+  return { day: request.day };
+}
